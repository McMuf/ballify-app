# Copy this file to .env and fill in the values you have.
# The app runs in a degraded/fallback mode for any source you leave blank.

# --- Reddit (sentiment source) ---
# Create a free "script" app at https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=ballify/0.1 by your-reddit-username

# --- The Odds API (market win probability) ---
# Free tier key from https://the-odds-api.com/
ODDS_API_KEY=

# --- Database ---
DATABASE_URL=sqlite:///./ballify.db

# --- CORS ---
WEB_ORIGIN=http://localhost:3000
